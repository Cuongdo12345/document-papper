#Cấu hình môi trường backend
PORT=
MONGO_URI=
JWT_SECRET =
JWT_REFRESH_SECRET =
# JWT_EXPIRES_IN =

# BR-01 (2026-09-29): bật route tự đăng ký công khai POST /api/auths/register.
# Mặc định TẮT (bỏ trống hoặc khác "true" => route trả 404) — tài khoản tạo
# qua trang Quản lý người dùng (POST /api/users, Admin). Chỉ đặt "true" khi
# thật sự muốn cho người ngoài tự tạo tài khoản role DEFAULT_REGISTER_ROLE_NAME.
ALLOW_SELF_REGISTER=
DEFAULT_REGISTER_ROLE_NAME =

# BR-18 (2026-09-30): trang Swagger UI /api-docs. Mặc định TẮT (404) — chỉ bật
# khi NODE_ENV=development, hoặc khi đặt đúng "true" ở biến này (vd máy chủ thử
# nghiệm). Trang cho xem toàn bộ API và gọi thử ngay trên trình duyệt mà không
# cần đăng nhập để xem, nên KHÔNG bật trên production thật.
ENABLE_API_DOCS=

# MongoDB connection pool (config/database/database.ts) — KHÔNG bắt buộc,
# có default trong code nếu bỏ trống: maxPoolSize=20, minPoolSize=2.
# DEV-019/ARCH-28: 2 biến này dùng thật nhưng trước đây thiếu tài liệu ở
# file này.
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=

# CLIENT_URL — dùng CHO CẢ 2 mục đích: (1) CORS origin (app.ts), (2) link
# trong email đặt lại mật khẩu (auths.service.ts). KHÔNG phải chỉ cấu hình
# frontend port như comment cũ — BẮT BUỘC phải set (server.ts fail-fast
# nếu thiếu, xem DEV-014). DEV-019/ARCH-28: trước đây khai TRÙNG LẶP 2 lần
# ở 2 nhóm khác nhau trong file này — gộp lại còn 1 dòng duy nhất.
CLIENT_URL=

# BR-08 (2026-09-29): số lớp reverse proxy đứng trước Node, để `req.ip` là IP
# thật của người dùng (rate limit đăng nhập theo IP + IP ở "Phiên đăng nhập").
# Bỏ trống/0 = tắt (dev chạy trực tiếp). Production theo kế hoạch deploy
# (Cloudflare -> Nginx -> Node) đặt TRUST_PROXY=2. KHÔNG đặt "true" (server sẽ
# từ chối khởi động — cho phép giả IP qua header X-Forwarded-For).
TRUST_PROXY=

#Cấu hình môi trường email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
# VITE_API_BASE_URL=

# DEV-023/ARCH-15/REF-018: `MONGO_DEBUG`/`MONGO_SLOW_MS` đã BỊ XOÁ khỏi file
# này — `config/database/mongo.logger.ts` (hàm duy nhất từng đọc 2 biến này,
# `registerMongoLogger()`, chưa từng được gọi ở bất kỳ đâu — xác nhận DEV-019)
# đã được xoá hẳn vì hoàn toàn dead code. Nếu sau này cần tính năng log
# chi tiết truy vấn MongoDB, viết lại module đó từ đầu và thêm lại biến
# tương ứng — không phục hồi comment/biến cũ (chỉ gây hiểu nhầm đang hoạt
# động trong khi thực tế không có gì đọc chúng).
NODE_ENV=

# Tỉ lệ sample cho performance log của request bình thường (0 -> 1), request
# chậm/lỗi luôn được log 100% bất kể giá trị này (mặc định code: 0.1 = 10%).
PERF_SAMPLE_RATE=

# TTL (ms) cho cache in-memory của các API dashboard - giảm số lần tính lại
# aggregate khi nhiều user cùng mở dashboard gần nhau (mặc định code: 30000 = 30s).
DASHBOARD_CACHE_TTL_MS=

# Roadmap B5 (2026-09-18) — khoá RSA "ký nội bộ" cho PDF xuất từ Document
# (shared/utils/pdfSignature.util.ts). ĐÂY KHÔNG PHẢI chữ ký số CA hợp lệ
# pháp lý (Luật Giao dịch điện tử) — chỉ xác thực tính toàn vẹn dữ liệu tại
# thời điểm xuất PDF trong nội bộ hệ thống. Sinh 1 lần bằng
# `npx ts-node scripts/generate-pdf-signing-keys.ts`, dán nguyên 2 dòng in
# ra vào đây (PEM đã encode base64 để giữ 1 dòng .env). MỖI môi trường
# (dev/staging/prod) PHẢI có cặp khoá RIÊNG, không dùng chung.
PDF_SIGN_PRIVATE_KEY=
PDF_SIGN_PUBLIC_KEY=

# Tên đơn vị hiển thị ở đầu PDF xuất (Roadmap B5) — CHƯA có logo/letterhead
# thật trong repo (user xác nhận dùng tạm header text), để trống thì code
# tự fallback "ĐƠN VỊ Y TẾ" (documentPdf.service.ts).
ORG_DISPLAY_NAME=

# https://github.com/OpenAPITools/openapi-generator?utm_source=chatgpt.com
# https://github.com/OpenAPITools/openapi-generator?utm_source=chatgpt.com
