#Cấu hình môi trường backend
PORT=
MONGO_URI=
JWT_SECRET =
JWT_REFRESH_SECRET =
# JWT_EXPIRES_IN =
DEFAULT_REGISTER_ROLE_NAME =

# MongoDB connection pool (config/database/database.ts) — KHÔNG bắt buộc,
# có default trong code nếu bỏ trống: maxPoolSize=20, minPoolSize=2.
# DEV-019/ARCH-28: 2 biến này dùng thật nhưng trước đây thiếu tài liệu ở
# file này.
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=

# CLIENT_URL — dùng CHO CẢ 2 mục đích: (1) CORS origin (app.ts), (2) link
# trong email đặt lại mật khẩu (auths.service.ts). KHÔNG phải chỉ cấu hình
# frontend port như comment cũ — BẮT BUỘC phải set (server.ts fail-fast
# nếu thiếu, xem DEV-014). DEV-019/ARCH-28: trước đây khai TRÙNG LẶP 2 lần
# ở 2 nhóm khác nhau trong file này — gộp lại còn 1 dòng duy nhất.
CLIENT_URL=

#Cấu hình môi trường email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
# VITE_API_BASE_URL=

# DEV-023/ARCH-15/REF-018: `MONGO_DEBUG`/`MONGO_SLOW_MS` đã BỊ XOÁ khỏi file
# này — `config/database/mongo.logger.ts` (hàm duy nhất từng đọc 2 biến này,
# `registerMongoLogger()`, chưa từng được gọi ở bất kỳ đâu — xác nhận DEV-019)
# đã được xoá hẳn vì hoàn toàn dead code. Nếu sau này cần tính năng log
# chi tiết truy vấn MongoDB, viết lại module đó từ đầu và thêm lại biến
# tương ứng — không phục hồi comment/biến cũ (chỉ gây hiểu nhầm đang hoạt
# động trong khi thực tế không có gì đọc chúng).
NODE_ENV=

# Tỉ lệ sample cho performance log của request bình thường (0 -> 1), request
# chậm/lỗi luôn được log 100% bất kể giá trị này (mặc định code: 0.1 = 10%).
PERF_SAMPLE_RATE=

# TTL (ms) cho cache in-memory của các API dashboard - giảm số lần tính lại
# aggregate khi nhiều user cùng mở dashboard gần nhau (mặc định code: 30000 = 30s).
DASHBOARD_CACHE_TTL_MS=

# https://github.com/OpenAPITools/openapi-generator?utm_source=chatgpt.com
# https://github.com/OpenAPITools/openapi-generator?utm_source=chatgpt.com
