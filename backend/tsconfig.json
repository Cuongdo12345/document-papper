{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "src/shared/types"]
  },
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
